# Using Alpine for the DB to minimize the attack surface and image footprint
FROM postgres:16-alpine

# Set build-time arguments for custom configuration
ARG DB_LOCALE=en_US.UTF-8

# Environment variables for default setup (can be overridden in Compose)
ENV POSTGRES_DB=django_db \
    POSTGRES_USER=django_user \
    LANG=$DB_LOCALE

# 1. Custom Configuration: 
# Copy a tuned postgresql.conf to optimize for containerized environments
# (e.g., setting shared_buffers, max_connections based on container limits)
COPY ./config/my-postgres.conf /etc/postgresql/postgresql.conf

# 2. Initialization Scripts:
# Any .sql or .sh scripts in this directory are executed in alphabetical order
# when the container is first created.
COPY ./init-scripts/ /docker-entrypoint-initdb.d/

# 3. Security:
# Ensure the custom config file has correct ownership (Postgres runs as UID 999)
RUN chown postgres:postgres /etc/postgresql/postgresql.conf

# Use the custom config file during startup
CMD ["postgres", "-c", "config_file=/etc/postgresql/postgresql.conf"]